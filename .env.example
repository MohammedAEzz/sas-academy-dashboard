# Postgres connection string. Production uses Neon via the Vercel Marketplace.
DATABASE_URL=postgres://user:password@host/dbname

# Single admin password for preview, commit, history, and revert.
ADMIN_PASSWORD=change-me

# HMAC key for the admin session cookie. Use at least 16 random characters.
SESSION_SECRET=change-me-to-a-long-random-string
